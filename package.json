{
  "name": "creditmate-ai",
  "version": "0.1.0",
  "description": "",
  "main": "src/index.tsx",
  "private": true,
  "dependencies": {
    "framer-motion": "^12.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "serve": "^14.2.1",
    "styled-components": "^6.1.18",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test e2e/visual-regression.spec.ts",
    "test:e2e:visual:update": "playwright test e2e/visual-regression.spec.ts --update-snapshots",
    "tokens:build": "style-dictionary build -c style-dictionary.config.mjs",
    "tokens:clean": "style-dictionary clean -c style-dictionary.config.mjs",
    "tokens:check": "node scripts/verify-tokens.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "lint": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "check-format": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "check-lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "check-types": "tsc --noEmit",
    "bundle:budget": "node scripts/bundle-budget.js",
    "bundle:budget:ci": "node scripts/bundle-budget.js --budget=210",
    "lighthouse": "node scripts/lighthouse-runner.js",
    "lighthouse:ci": "node scripts/lighthouse-runner.js --runs=1",
    "prepare": "husky install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:build": "storybook build --output-dir storybook-static",
    "chromatic": "chromatic --config chromatic.config.json",
    "check:all": "npm run check-types && npm run check-lint && npm run check-format && npm test -- --runInBand && npm run build && npm run bundle:budget",
    "dev": "vite",
    "preview": "vite preview",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.29.0",
    "@babel/preset-typescript": "^7.29.0",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "^8.6.19",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/addon-viewport": "^8.6.19",
    "@storybook/react-webpack5": "^8.6.19",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-jest": "^30.5.2",
    "chromatic": "^11.25.2",
    "cross-fetch": "^4.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^15.2.0",
    "msw": "^1.3.5",
    "prettier": "^2.8.8",
    "storybook": "^8.6.19",
    "style-dictionary": "^4.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "babel-loader": "^10.0.0",
    "@testing-library/jest-dom": "^5.17.0"
  },
  "overrides": {
    "compression": "^1.8.2",
    "underscore": "^1.13.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  }
}
