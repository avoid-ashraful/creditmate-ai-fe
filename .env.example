# Development server port
PORT=3000

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1

# Feature Flags
# Only honoured when NODE_ENV=development (never in production builds).
REACT_APP_ENABLE_API_LOGGING=false

# Analytics
# Leave unset to keep analytics disabled. Configure a non-secret local integration key
# before registering a provider. No analytics request is made without both a key and provider.
REACT_APP_ANALYTICS_KEY=

# Public site origin used for sitemap.xml and robots.txt (scripts/generate-sitemap.mjs).
# Leave unset locally; set it for production builds (e.g. https://creditmate.ai).
REACT_APP_SITE_URL=
